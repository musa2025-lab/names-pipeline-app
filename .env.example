# Copy to .env and fill in. .env is gitignored - never commit it.

# ── Required ──────────────────────────────────────────────────────────────
# https://console.anthropic.com -> API keys.
# Use a key dedicated to this app so it can be revoked independently.
ANTHROPIC_API_KEY=sk-ant-...

# ── Access control - pick exactly ONE ─────────────────────────────────────
# The app refuses to start unless one of these is set. It handles beneficiary
# names, phone numbers and national IDs, so it must not be reachable openly.

# 1. PREFERRED - Azure App Service Authentication (Entra ID) in front of the app.
#    Set this only AFTER switching Authentication on in the Azure Portal.
# AUTH_MODE=platform

# 2. FALLBACK - shared team password, for when SSO isn't available.
#    Weaker: no per-person audit trail, and removing one person's access means
#    rotating the password for everyone.
# APP_PASSWORD=choose-a-long-random-password

# 3. LOCAL DEVELOPMENT ONLY - no access control at all. Never set this on a
#    hosted URL.
# ALLOW_NO_AUTH=true
